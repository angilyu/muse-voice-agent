# ---------------------------------------------------------------------------
# MuseVoiceAgent configuration. Copy to .env and fill in.
# ---------------------------------------------------------------------------

# --- LLM (LangGraph uses langchain's init_chat_model, "provider:model") ------
OPENAI_API_KEY=
LLM_MODEL=openai:gpt-5.4@low
# OpenAI service tier: default (standard processing). priority is faster but ~2x price; opt-in only.
LLM_SERVICE_TIER=default

# --- LiveKit Cloud (https://cloud.livekit.io -> Settings -> API keys) ---------
# Also used for LiveKit Inference STT / TTS / turn detection.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Telephony: outbound SIP trunk (e.g. Twilio / Telnyx) -----------------------
# Create with: lk sip outbound create outbound-trunk.json ; list with: lk sip outbound list
SIP_OUTBOUND_TRUNK_ID=

# Name the worker registers under; the MCP server dispatches calls to it.
AGENT_NAME=muse-voice-agent

# --- Voice (LiveKit Inference model ids) ----------------------------------------
STT_MODEL=assemblyai/universal-3-5-pro
TTS_MODEL=fishaudio/s2.1-pro
TTS_VOICE=fa4c9eb3dccc4806b382b40d61c6b10a

# --- MCP server that Muse connects to --------------------------------------------
MCP_HOST=127.0.0.1
MCP_PORT=8765
# Muse sends this as "Authorization: Bearer <token>". Generate with:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
MCP_AUTH_TOKEN=
# Free hosts (Render Free) sleep when idle; >0 makes the server ping PUBLIC_BASE_URL/healthz this often
KEEPALIVE_SECONDS=0

# --- Behaviour / safety --------------------------------------------------------
# true = simulate calls (no LiveKit / phone needed). Set false for real calls.
DRY_RUN=true
# Comma-separated E.164 prefixes the agent may dial.
ALLOWED_DIAL_PREFIXES=+1
MAX_CALL_SECONDS=300
MAX_CONCURRENT_CALLS=3
# If the backend records calls, disclose it early. Scope can be "always" (recommended/default)
# or "required_states" (known all-party-consent states and unknown area codes).
CALL_RECORDING_ENABLED=true
RECORDING_DISCLOSURE_SCOPE=always
# Retell: speak first if nobody talks this long after pickup (call screeners); 0 disables
SILENT_PICKUP_MS=3000
INBOUND_GREET_MS=500
# Retell inbound: match callbacks to outbound calls from this many days back.
INBOUND_CALLBACK_LOOKBACK_DAYS=14
# Used when Muse doesn't pass a callback number. (MCP call tools require Muse to pass customer_name;
# DEFAULT_CUSTOMER_NAME is only used by the LiveKit console agent.)
DEFAULT_CUSTOMER_NAME=
DEFAULT_CALLBACK_NUMBER=

# Twilio (used only to provision the phone number + Elastic SIP trunk)
# console.twilio.com -> Account Info
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Written by scripts/setup_twilio_trunk.py
TWILIO_SIP_USERNAME=
TWILIO_SIP_PASSWORD=

# Voice/telephony backend for live calls: retell (default) or livekit
VOICE_BACKEND=retell

# Retell (voice + telephony). dashboard.retellai.com -> Settings -> API Keys
RETELL_API_KEY=
RETELL_VOICE_ID=cartesia-Cleo
# Written by scripts/setup_retell.py
RETELL_AGENT_ID=
RETELL_FROM_NUMBER=
RETELL_WS_SECRET=
# Public https URL of muse-voice-mcp (e.g. the cloudflared tunnel); the Retell agent is synced to it
PUBLIC_BASE_URL=

# --- Accounts & billing (Stripe) ------------------------------------------------
# Users sign up at PUBLIC_BASE_URL/pricing, confirm their email with a code, get an API key, and use
# it as their bearer token. MCP_AUTH_TOKEN stays an unmetered admin key. Sign-ups stay closed until
# the secret key, at least one plan price and email (SMTP_*, below) are set. dashboard.stripe.com -> Developers -> API keys / Webhooks; Product catalog -> price ids.
STRIPE_SECRET_KEY=
# Recurring monthly prices: Starter ($5/month) and Plus ($20/month)
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PLUS=
# Webhook endpoint: PUBLIC_BASE_URL/stripe/webhook
STRIPE_WEBHOOK_SECRET=
# One-time free call minutes for each new account; minutes included per billing period (0 = unlimited)
FREE_TRIAL_MINUTES=10
STARTER_MINUTES=50
PLUS_MINUTES=200
# Days a past_due subscription keeps working while Stripe retries the card
BILLING_GRACE_DAYS=3
# A call that started with minutes left is ended politely this many minutes past them
CALL_OVERAGE_MINUTES=20
MAX_CONCURRENT_CALLS_PER_ACCOUNT=2
SIGNUPS_PER_IP_PER_DAY=3
# Signs account-page cookies; defaults to a value derived from MCP_AUTH_TOKEN
BILLING_SESSION_SECRET=
SUPPORT_EMAIL=
# Email for sign-up/sign-in codes. Port 587 = STARTTLS, 465 = TLS. Gmail: smtp.gmail.com with an
# app password. SMTP_HOST=log writes emails to the server log (local testing only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
# SQLite file for calls, accounts and keys. Must be on a persistent disk in production.
CALL_DB_PATH=

# --- Render hosting (deploy-time only; not read by the app) ---
# Create at https://dashboard.render.com/u/settings#api-keys
RENDER_API_KEY=

# --- Evals (dev-only; not read by the app) ---
# GitHub token with Copilot access, used by `python -m evals.text` for Copilot-hosted models.
# Leave empty to use the signed-in Copilot CLI account.
COPILOT_GITHUB_TOKEN=
