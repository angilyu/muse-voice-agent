# ---------------------------------------------------------------------------
# MuseVoiceAgent configuration. Copy to .env and fill in.
# ---------------------------------------------------------------------------

# --- LLM (LangGraph uses langchain's init_chat_model, "provider:model") ------
OPENAI_API_KEY=
LLM_MODEL=openai:gpt-4.1-mini

# --- LiveKit Cloud (https://cloud.livekit.io -> Settings -> API keys) ---------
# Also used for LiveKit Inference STT / TTS / turn detection.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# --- Telephony: outbound SIP trunk (e.g. Twilio / Telnyx) -----------------------
# Create with: lk sip outbound create outbound-trunk.json ; list with: lk sip outbound list
SIP_OUTBOUND_TRUNK_ID=

# Name the worker registers under; the MCP server dispatches calls to it.
AGENT_NAME=muse-voice-agent

# --- Voice (LiveKit Inference model ids) ----------------------------------------
STT_MODEL=assemblyai/universal-3-5-pro
TTS_MODEL=fishaudio/s2.1-pro
TTS_VOICE=fa4c9eb3dccc4806b382b40d61c6b10a

# --- MCP server that Muse connects to --------------------------------------------
MCP_HOST=127.0.0.1
MCP_PORT=8765
# Muse sends this as "Authorization: Bearer <token>". Generate with:
#   python -c "import secrets;print(secrets.token_urlsafe(32))"
MCP_AUTH_TOKEN=

# --- Behaviour / safety --------------------------------------------------------
# true = simulate calls (no LiveKit / phone needed). Set false for real calls.
DRY_RUN=true
# Comma-separated E.164 prefixes the agent may dial.
ALLOWED_DIAL_PREFIXES=+1
MAX_CALL_SECONDS=300
MAX_CONCURRENT_CALLS=3
# Used when Muse doesn't pass a name / callback number.
DEFAULT_CUSTOMER_NAME=
DEFAULT_CALLBACK_NUMBER=
